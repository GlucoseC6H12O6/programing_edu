---
import Base from "../layouts/Base.astro";
import { loadLessons, type Lesson } from "../content/lessons.ts";
import { loadIntros } from "../content/textbook.ts";

const lessons = loadLessons();
const totalEvents = lessons.reduce(
  (sum, lesson) => sum + lesson.traces.reduce((n, t) => n + t.doc.events.length, 0),
  0,
);
const traced = lessons.filter((lesson) => lesson.traces.length > 0).length;

// §2.1/2.2의 단계 순서. 목록이 25개를 넘으면 평평한 나열은 읽히지 않는다.
const STAGES = ["기초", "흐름 제어", "함수와 데이터 처리", "응용 문법", "종합 실습"];
const TRACKS: { key: Lesson["track"]; label: string }[] = [
  { key: "python", label: "Python" },
  { key: "javascript", label: "JavaScript" },
];

const intros = loadIntros();

const groups = TRACKS.map((track) => ({
  ...track,
  intro: intros.get(track.key),
  stages: STAGES.map((stage) => ({
    stage,
    items: lessons.filter((lesson) => lesson.track === track.key && lesson.stage === stage),
  })).filter((group) => group.items.length > 0),
})).filter((track) => track.stages.length > 0);
---

<Base title="프로그래밍 기초 교육 사이트">
  <main class="page">
    <header class="page-head">
      <p class="eyebrow">프로그래밍 기초 교육 사이트</p>
      <h1>Python · JavaScript 기초</h1>
      {/*
        먼저 읽어야 할 것은 "어떻게 만들었나"가 아니라 "어떻게 공부하나"다.
        처음 온 사람에게 AST와 CPython을 먼저 말하면, 정작 이 교재의 전부인
        예측 → Step → 관찰 순서를 모른 채 레슨으로 들어간다. 만든 방식은
        궁금한 사람만 펴 보도록 접어 둔다.
      */}
      <div class="notice">
        <strong>읽고 끝내는 페이지가 아니라 돌려 보는 페이지입니다.</strong>
        실행하기 전에 결과를 먼저 적고, <kbd>Step</kbd>으로 한 사건씩 확인하고,
        무엇이 바뀌었는지 관찰합니다. 예측이 틀리는 순간이 이 교재가 노리는 지점입니다.
        <br />
        처음이라면 트랙의 <strong>시작하기</strong>부터 — 목적, 사용법, 화면의 표시가
        무엇을 뜻하는지(시각 언어), 전체 학습 지도가 있습니다.
        <span class="notice-links">
          {[...intros.values()].map((intro) => (
            <a href={`/guide/${intro.language}`}>{intro.title} 시작하기 →</a>
          ))}
        </span>
      </div>

      <details class="notice-tech">
        <summary>단계 실행은 어떻게 만들어졌나</summary>
        <p>
          <strong>단계 실행이 붙은 레슨</strong>은 코드를 AST로 계측해 <strong>진짜 런타임으로 실행</strong>한
          결과를 재생합니다. Python은 <code>tracer.py</code>가 CPython으로, JavaScript는
          <code>tracer.ts</code>가 Node로 돌립니다. 인터프리터를 흉내 내지 않으므로 실제 동작과 어긋날 수
          없습니다. 실행은 빌드 타임에 끝났고 브라우저는 커밋된 이벤트 배열 위에서 커서만 움직입니다.
          <br />
          레슨 {lessons.length}개 · 그중 단계 실행 {traced}개 · 이벤트 {totalEvents.toLocaleString()}개.
        </p>
      </details>
    </header>

    {groups.map((track) => (
      <section class="curriculum-track">
        <h2 class="curriculum-track-title">
          {track.label}
          {track.intro && (
            <a class="track-guide" href={`/guide/${track.key}`}>시작하기 · 학습 지도</a>
          )}
        </h2>
        {track.stages.map((group) => (
          <div class="curriculum-stage">
            <h3 class="curriculum-stage-title">{group.stage}</h3>
            <ul class="lesson-list">
              {group.items.map((lesson) => (
                <li>
                  <a href={`/lessons/${lesson.id}`}>
                    <span class="eyebrow">{lesson.id.split("-")[0]!.toUpperCase()}</span>
                    <strong>{lesson.title}</strong>
                    <span class="lesson-list-meta">
                      {lesson.time ? `약 ${lesson.time.total}분` : "시간 미정"}
                      {lesson.traces.length > 0
                        ? ` · 단계 실행 ${lesson.traces.length}개 · ${lesson.traces
                            .reduce((n, t) => n + t.doc.events.length, 0)
                            .toLocaleString()}개 이벤트`
                        : " · 원고"}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </main>
</Base>
